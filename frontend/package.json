{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "test": "node --test tests/*.test.mjs",
        "dev": "vite --host 0.0.0.0",
        "build": "vue-tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "npm run lint && npm run format && npm run build",
        "preview": "vite preview --host 127.0.0.1 --port 5173"
    },
    "dependencies": {
        "@primeuix/themes": "^1.2.5",
        "@tailwindcss/vite": "^4.3.3",
        "@unhead/vue": "^3.4.3",
        "axios": "^1.20.0",
        "javascript-time-ago": "^2.6.4",
        "primeicons": "^7.0.0",
        "primevue": "^4.5.5",
        "tailwindcss": "^4.3.3",
        "tailwindcss-primeui": "^0.6.1",
        "vue": "^3.5.44",
        "vue-recaptcha": "^3.0.0-alpha.6",
        "vue-router": "^4.6.4",
        "vue3-pdf-app": "^1.0.3",
        "vuex": "^4.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "prettier": "^3.9.10",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "3.1.4"
    }
}
